# Sao chép thành .env.local và điền giá trị. KHÔNG commit khoá thật.

# Postgres (Supabase hoặc local) — dùng cho Drizzle và script import nội dung
DATABASE_URL=

# Supabase (khoá public/anon; khoá service-role chỉ đặt ở server, không đặt NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Địa chỉ gốc của site (không có "/" cuối), dùng cho canonical, Open Graph, sitemap.xml và robots.txt.
# Ví dụ: https://topikly.example. Để trống thì dùng http://localhost:3000 (chỉ phù hợp khi chạy dev).
NEXT_PUBLIC_SITE_URL=
